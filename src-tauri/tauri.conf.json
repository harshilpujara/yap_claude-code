{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yapp",
  "version": "0.1.0",
  "identifier": "com.yapp.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "yapp", "width": 560, "height": 780, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
